---
interface Props {
  label?: string;
  class?: string;
  iconClass?: string;
}

const { label = 'Toggle Theme', class: className = '', iconClass = 'h-6 w-6 fill-current text-current' } = Astro.props;
---

<theme-toggle style="display: contents">
  <button
    class={'group cursor-pointer select-none items-center float-right p-2 ' + className}
    title={label}
    data-theme-toggle
  >
    <!-- Single Combined Smooth Animated SVG -->
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class={iconClass}>
      <defs>
        <!-- The Mask creates the crescent moon shape by subtracting a circle -->
        <mask id="theme-toggle-mask">
          <circle cx="12" cy="12" r="12" fill="white"></circle>
          <circle
            cx="20"
            cy="4"
            r="4"
            fill="black"
            class="group-dark:-translate-x-1.25 group-dark:translate-y-1.25 origin-center transition-all duration-500 ease-in-out"
          ></circle>
        </mask>
      </defs>
      <!-- Center Icon Core (Transforms between Full Sun and Crescent Moon) -->
      <circle
        cx="12"
        cy="12"
        r="5"
        mask="url(#theme-toggle-mask)"
        class="group-dark:scale-200 origin-center transition-all duration-500 ease-in-out"></circle>
      <!-- Outer Rays Group -->
      <g
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="group-dark:scale-0 group-dark:opacity-0 origin-center transition-all duration-500 ease-in-out"
      >
        <line x1="12" y1="2" x2="12" y2="4"></line>
        <line x1="12" y1="20" x2="12" y2="22"></line>
        <line x1="2" y1="12" x2="4" y2="12"></line>
        <line x1="20" y1="12" x2="22" y2="12"></line>
        <line x1="5.11" y1="5.11" x2="6.53" y2="6.53"></line>
        <line x1="17.47" y1="17.47" x2="18.89" y2="18.89"></line>
        <line x1="5.11" y1="18.89" x2="6.53" y2="17.47"></line>
        <line x1="17.47" y1="6.53" x2="18.89" y2="5.11"></line>
      </g>
    </svg>
  </button>
</theme-toggle>

<script>
  class ThemeToggle extends HTMLElement {
    constructor() {
      super();
      const button = this.querySelector('button');

      button?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    }
  }

  // Register as a Custom Element to scope queries safely
  customElements.define('theme-toggle', ThemeToggle);
</script>
